{
    "include": [
        "./**/*.ts",
        "./index.ts", "../../veela.css/src/scss/basic/index.ts", "../../veela.css/src/scss/advanced/index.ts",
    ],
    "exclude": [
        "../../dist/**/*",
        "../../externals/**/*",
        "./src/**/*.js",
        "./src/**/*.jsx",
        "../legacy/**/*",
        "../test/**/*"
    ],
    "compilerOptions": {
        "outDir": "../../dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": [
                "../../../../node_modules/@phosphor-icons/core/assets/*"
            ],
            "fl-ui/*": [
                "./ui/*"
            ],
            "@fest-lib/fl-ui": [
                "./src/index.ts"
            ],
            "@fest-lib/image": [
                "../../image.ts/src/index.ts"
            ],
            "@fest-lib/lure": [
                "../../lur.e/src/index.ts"
            ],
            "@fest-lib/object": [
                "../../object.ts/src/index.ts"
            ],
            "@fest-lib/dom": [
                "../../dom.ts/src/index.ts"
            ],
            "@fest-lib/uniform": [
                "../../uniform.ts/src/index.ts"
            ],
            "@fest-lib/theme": [
                "../../theme.core/src/index.ts"
            ],
            "@fest-lib/core": [
                "../../core.ts/src/index.ts"
            ],
            "@fest-lib/icon": [
                "../../icon.ts/src/index.ts"
            ],
            "@fest-lib/polyfill/*": [
                "../../shared/fest/polyfill/*"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "declaration": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "typeRoots": [
            "plugins/global.d.ts"
        ],
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
