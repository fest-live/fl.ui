{
    "include": [
        "./**/*.ts",
        "./index.ts",
    ],
    "exclude": [
        "../../dist/**/*",
        "../../externals/**/*",
        "./src/**/*.js",
        "./src/**/*.jsx",
        "../legacy/**/*",
        "../test/**/*"
    ],
    "compilerOptions": {
        "outDir": "../../dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": [
                "../../../../node_modules/@phosphor-icons/core/assets/*"
            ],
            "fl-ui/*": [
                "./ui/*"
            ],
            "fest/fl-ui": [
                "./src/index.ts"
            ],
            "fest/image": [
                "../../image.ts/src/index.ts"
            ],
            "fest/lure": [
                "../../lur.e/src/index.ts"
            ],
            "fest/object": [
                "../../object.ts/src/index.ts"
            ],
            "fest/dom": [
                "../../dom.ts/src/index.ts"
            ],
            "fest/uniform": [
                "../../uniform.ts/src/index.ts"
            ],
            "fest/theme": [
                "../../theme.core/src/index.ts"
            ],
            "fest/core": [
                "../../core.ts/src/index.ts"
            ],
            "fest/icon": [
                "../../icon.ts/src/index.ts"
            ],
            "fest/polyfill/*": [
                "../../shared/fest/polyfill/*"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "declaration": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "typeRoots": [
            "plugins/global.d.ts"
        ],
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
