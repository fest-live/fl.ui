{
    "include": ["./**/*.ts", "./index.ts", "../**/*.ts"],
    "exclude": ["../../dist/**/*", "../../externals/**/*"],
    "compilerOptions": {
        "outDir": "../../dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": ["../../node_modules/@phosphor-icons/core/assets/*"],
            "fonts/*": ["../../fonts/*"],
            "fest/*": ["../*"],
            "fest/cdnImport": ["../cdnImport.mjs", "../../../shared/fest/cdnImport.mjs"],
            "fest/dom": ["../dom/index.ts", "../../../shared/fest/dom/index.ts"],
            "fest/lure": ["../lure/index.ts", "../../../shared/fest/lure/index.ts"],
            "fest/object": ["../object/index.ts", "../../../shared/fest/object/index.ts"],
            "fest/uniform": ["../uniform/index.ts", "../../../shared/fest/uniform/index.ts"],
            "fest/theme": ["../theme/index.ts", "../../../shared/fest/theme/index.ts"],
            "fest/fl-ui": ["./index.ts", "../../../shared/fest/fl-ui/index.ts"],
            "fest/ui": ["./index.ts", "../../../shared/fest/ui/index.ts"],
            "fest/polyfill/*": ["../polyfill/*", "../../../shared/fest/polyfill/*"],


            "veela": ["../../veela.css/src/index.ts"],
            "veela/*": ["../../veela.css/src/scss/*"],
            "veela-runtime": ["../../veela.css/src/scss/runtime/index.ts"],
            "veela-runtime/*": ["../../veela.css/src/scss/runtime/*"],
            "veela-runtime/index": ["../../veela.css/src/scss/runtime/index.scss"],
            "veela-lib": ["../../veela.css/src/scss/lib/index.scss"],
            "veela-lib/*": ["../../veela.css/src/scss/lib/*"],
            "veela-mixins": ["../../veela.css/src/scss/lib/mixins/index.scss"],
            "veela-mixins/*": ["../../veela.css/src/scss/lib/mixins/*"],

            "polyfill/*": ["../polyfill/*", "../../../shared/polyfill/*"],
            "@fl-design/*": ["./design/*", "../../../shared/fest/fl-ui/design/*"],
            "@fl-ui/*": ["./ui/*", "../../../shared/fest/fl-ui/ui/*"],
            "@fl-src/*": ["./*", "../../../shared/fest/fl-ui/*"]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "WebWorker"],
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "declaration": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "typeRoots": ["plugins/global.d.ts"],
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "allowArbitraryExtensions": true
    }
}
