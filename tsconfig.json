{
    "include": [
        "./src/**/*.ts",
        "./test/*.ts",
        "./test/**/*.ts"
    ],
    "exclude": [
        "./dist/**/*",
        "./externals/**/*",
        "./legacy/**/*.ts",
        "./src/**/*.js",
        "./src/**/*.jsx"
    ],
    "compilerOptions": {
        "rootDir": "../",
        "outDir": "./dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": [
                "../../../node_modules/@phosphor-icons/core/assets/*"
            ],
            "fonts/*": [
                "../../../modules/shared/assets/fonts/*"
            ],
            "@fest-lib/*": [
                "../../../modules/shared/fest/*"
            ],
            "@fest-lib/cdnImport": [
                "./typings/cdnImport.d.ts"
            ],
            "@fest-lib/style-lib": [
                "../style.ts/src/index.ts"
            ],
            "@fest-lib/dom": [
                "../dom.ts/src/index.ts"
            ],
            "@fest-lib/lure": [
                "../lur.e/src/index.ts"
            ],
            "@fest-lib/lure/idb-fs": [
                "../lur.e/src/utils/opfs/IdbFs.ts"
            ],
            "@fest-lib/lure/provide": [
                "../lur.e/src/utils/opfs/provide.ts"
            ],
            "@fest-lib/lure/remote-fs": [
                "../lur.e/src/utils/opfs/remote-fs.ts"
            ],
            "@fest-lib/object": [
                "../object.ts/src/index.ts"
            ],
            "@fest-lib/core": [
                "../core.ts/src/index.ts"
            ],
            "@fest-lib/icon": [
                "../icon.ts/src/index.ts"
            ],
            "@fest-lib/fl-ui": [
                "./src/index.ts"
            ],
            "@fest-lib/image": [
                "../image.ts/src/index.ts"
            ],
            "@fest-lib/ui": [
                "./src/index.ts"
            ],
            "@fest-lib/uniform": [
                "../uniform.ts/src/index.ts"
            ],
            "@fest-lib/uniform/mounted-fs": [
                "../uniform.ts/src/newer/messaging/MountedFs.ts"
            ],
            "@fest-lib/polyfill/*": [
                "../../../modules/shared/fest/polyfill/*"
            ],
            "polyfill/*": [
                "../../../modules/shared/fest/polyfill/*"
            ],
            "fl-ui/*": [
                "./src/ui/*"
            ],
            "fl-src/*": [
                "./src/*"
            ],
            "fl-ui/items/*": [
                "./src/ui/items/*"
            ],
            "fl-ui/items/BaseElement": [
                "./src/ui/items/base/BaseElement.ts"
            ],
            "fl-ui/items/BaseElement.ts": [
                "./src/ui/items/base/BaseElement.ts"
            ],
            "@fest-lib/veela": [
                "../veela.css/src/index.ts",
                "../../../modules/shared/fest/veela/index.ts"
            ],
            "@fest-lib/veela/scss": [
                "../veela.css/src/scss/index.scss"
            ],
            "@fest-lib/veela/scss/*": [
                "../veela.css/src/scss/*"
            ],
            "@fest-lib/veela-runtime": [
                "../veela.css/src/scss/index.ts"
            ],
            "veela-lib": [
                "../veela.css/src/scss/index.scss"
            ],
            "veela-lib/*": [
                "../veela.css/src/scss/*"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "inlineSourceMap": true,
        "typeRoots": [
            "plugins/global.d.ts"
        ],
        "experimentalDecorators": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true,
        "allowImportingTsExtensions": true
    },
    "compileOnSave": false
}
