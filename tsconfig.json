{
    "include": [
        "./src/**/*.ts",
        "./test/*.ts",
        "./test/**/*.ts"
    ],
    "exclude": [
        "./dist/**/*",
        "./externals/**/*",
        "./legacy/**/*.ts",
        "./src/**/*.js",
        "./src/**/*.jsx"
    ],
    "compilerOptions": {
        "outDir": "./dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": [
                "../../../node_modules/@phosphor-icons/core/assets/*"
            ],
            "fonts/*": [
                "../../../modules/shared/assets/fonts/*"
            ],
            "fest/*": [
                "../../../modules/shared/fest/*"
            ],
            "fest/cdnImport": [
                "./typings/cdnImport.d.ts"
            ],
            "fest/dom": [
                "../dom.ts/src/index.ts"
            ],
            "fest/lure": [
                "../lur.e/src/index.ts"
            ],
            "fest/object": [
                "../object.ts/src/index.ts"
            ],
            "fest/core": [
                "../core.ts/src/index.ts"
            ],
            "fest/icon": [
                "../icon.ts/src/index.ts"
            ],
            "fest/fl-ui": [
                "./src/index.ts"
            ],
            "fest/image": [
                "../image.ts/src/index.ts"
            ],
            "fest/ui": [
                "./src/index.ts"
            ],
            "fest/uniform": [
                "../uniform.ts/src/index.ts"
            ],
            "fest/polyfill/*": [
                "../../../modules/shared/fest/polyfill/*"
            ],
            "polyfill/*": [
                "../../../modules/shared/fest/polyfill/*"
            ],
            "fl-ui/*": [
                "./src/ui/*"
            ],
            "fl-src/*": [
                "./src/*"
            ],
            "fl-ui/items/*": [
                "./src/ui/items/*"
            ],
            "fl-ui/items/BaseElement": [
                "./src/ui/items/base/BaseElement.ts"
            ],
            "fl-ui/items/BaseElement.ts": [
                "./src/ui/items/base/BaseElement.ts"
            ],
            "fest/veela": [
                "../veela.css/src/index.ts",
                "../../../modules/shared/fest/veela/index.ts"
            ],
            "fest/veela-runtime": [
                "../veela.css/src/index.ts",
                "../../../modules/shared/fest/veela/index.ts"
            ],
            "veela-lib": [
                "../veela.css/src/scss/lib/index.scss"
            ],
            "veela-lib/*": [
                "../veela.css/src/scss/lib/*"
            ]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "declaration": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "typeRoots": [
            "plugins/global.d.ts"
        ],
        "experimentalDecorators": true,
        "noEmit": true,
        "noEmitOnError": true,
        "noEmitHelpers": true
    },
    "compileOnSave": false
}
