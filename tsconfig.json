{
    "include": ["./src/**/*.ts", "./test/*.ts", "test/**/*.ts", "./legacy/**/*.ts"],
    "exclude": ["./dist/**/*", "./externals/**/*"],
    "compilerOptions": {
        "outDir": "./dist/",
        "paths": {
            "@phosphor-icons/core/assets/*": ["./node_modules/@phosphor-icons/core/assets/*"],
            "fonts/*": ["../../shared/assets/fonts/*"],
            "fest/*": ["../../shared/fest/*"],
            "fest/cdnImport": ["../../cdnImport.mjs"],
            "fest/dom": ["../dom.ts/src/index.ts"],
            "fest/lure": ["../lur.e/src/index.ts"],
            "fest/object": ["../object.ts/src/index.ts"],
            "fest/core": ["../core.ts/src/index.ts"],
            "fest/icon": ["../icon.ts/src/index.ts"],
            "fest/fl-ui": ["./src/index.ts"],
            "fest/ui": ["./src/index.ts"],
            "fest/uniform": ["../uniform.ts/src/index.ts"],
            "fest/theme": ["../theme.core/src/index.ts"],
            "fest/polyfill/*": ["../../shared/fest/polyfill/*"],
            "polyfill/*": ["../../shared/fest/polyfill/*"],
            "@fl-design/*": [
                "./src/design/*"
            ],
            "@fl-ui/*": [
                "./src/ui/*"
            ],
            "@fl-src/*": [
                "./src/*"
            ],
            "fest/veela": ["../veela.css/src/index.ts", "../../shared/fest/veela/index.ts"],
            "fest/veela-runtime": ["../veela.css/src/index.ts", "../../shared/fest/veela/index.ts"],
            "veela-lib": ["../veela.css/src/scss/lib/index.scss"],
            "veela-lib/*": ["../veela.css/src/scss/lib/*"],
            "fl-ui-lib": ["./src/styles/lib/_index.scss"],
            "fl-ui-lib/*": ["./src/styles/lib/*"],
            "fl-ui-core": ["./src/styles/core/_index.scss"],
            "fl-ui-core/*": ["./src/styles/core/*"]
        },
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "WebWorker"],
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "allowArbitraryExtensions": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "noImplicitAny": false,
        "declaration": false,
        "noImplicitThis": false,
        "inlineSources": true,
        "inlineSourceMap": true,
        "sourceMap": false,
        "typeRoots": ["plugins/global.d.ts"],
        "experimentalDecorators": true
    }
}
